export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected;
    in property <bool> compact;
    in property <int> badge: 0;
    callback clicked;
    height: compact ? 56px : 48px;
    border-radius: self.height / 2;
    background: selected ? Theme.secondary-container : touch.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent;
    animate background { duration: Theme.short; }
    accessible-role: tab;
    accessible-label: text;
    accessible-action-default => {
        root.clicked();
    }
    if !root.compact: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 24px;
                tint: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
            }
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.badge > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                width: max(20px, n.preferred-width + 12px);
                border-radius: 10px;
                background: Theme.primary;
                n := Text {
                    text: root.badge;
                    color: Theme.on-primary;
                    font-size: 11px;
                    font-weight: 700;
                }
            }
        }
    }
    if root.compact: Icon {
        name: root.icon;
        size: 24px;
        tint: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
    }
    if root.compact && root.badge > 0: Rectangle {
        x: root.width / 2 + 6px;
        y: 8px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.error;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Backdrop inherits Rectangle {
    background: Theme.low-end ? Theme.surface : @linear-gradient(180deg, Theme.wall-top 0%, Theme.wall-bottom 100%);
    if !Theme.low-end: Rectangle {
        width: root.width;
        height: root.height;
        clip: true;
        for i in 7: Rectangle {
            property <length> d: root.width * 0.95 * (1 - i / 8);
            x: root.width * 0.66 - self.d / 2;
            y: root.height * 0.02 - self.d / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            background: Theme.primary.with-alpha(Theme.dark ? 0.035 : 0.05);
        }
        for i in 7: Rectangle {
            property <length> d: root.width * 0.75 * (1 - i / 8);
            x: root.width * 0.1 - self.d / 2;
            y: root.height * 0.98 - self.d / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            background: Theme.tertiary.with-alpha(Theme.dark ? 0.03 : 0.045);
        }
    }
}
